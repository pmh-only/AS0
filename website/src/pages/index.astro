---
import Dither from "../components/Dither.jsx";
import LookingGlass from "../components/LookingGlass.jsx";
import "@fontsource-variable/space-grotesk";

const apiUrl = import.meta.env.PUBLIC_LOOKING_GLASS_API_URL ?? "https://lg.pmh.codes";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AS218822 public BGP looking glass" />
    <meta name="theme-color" content="#050505" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%238f36ff%22/><text x=%2250%22 y=%2268%22 text-anchor=%22middle%22 font-size=%2252%22 font-family=%22Arial%22 font-weight=%22700%22 fill=%22white%22>AS</text></svg>"
    />
    <title>AS218822</title>
    <style>
      :global(*) { box-sizing: border-box; }
      :global(html) { background: #050505; scroll-behavior: smooth; }
      :global(body) {
        min-width: 20rem;
        min-height: 100%;
        margin: 0;
        background: #050505;
        color: #fff;
        font-family: "Space Grotesk Variable", sans-serif;
      }
      :global(button), :global(input) { font: inherit; }
      :global(::selection) { background: #9b45f7; color: #fff; }

      .hero {
        position: relative;
        height: 100svh;
        min-height: 28rem;
        isolation: isolate;
        overflow: hidden;
      }

      .dither {
        position: absolute;
        z-index: -1;
        inset: 0;
      }

      .hero h1 {
        position: absolute;
        inset: 50% auto auto 50%;
        margin: 0;
        font-size: clamp(3.5rem, 13vw, 12rem);
        font-weight: 700;
        letter-spacing: -0.075em;
        line-height: 0.8;
        text-align: center;
        text-shadow: 0 0 3rem rgb(0 0 0 / 45%);
        transform: translate(-50%, -50%);
        pointer-events: none;
        user-select: none;
        white-space: nowrap;
      }

      .scroll-link {
        position: absolute;
        inset: auto auto 1.8rem 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.65rem;
        color: rgb(255 255 255 / 62%);
        font: 0.62rem "SFMono-Regular", Consolas, monospace;
        letter-spacing: 0.17em;
        text-decoration: none;
        text-transform: uppercase;
        transform: translateX(-50%);
      }

      .scroll-link::after {
        width: 1px;
        height: 2.25rem;
        background: linear-gradient(#fff, transparent);
        content: "";
      }

      .looking-glass-section {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
        border-top: 1px solid rgb(255 255 255 / 12%);
        background:
          radial-gradient(circle at 76% 20%, rgb(123 45 196 / 24%), transparent 34rem),
          #08070a;
      }

      .looking-glass-section::before {
        position: absolute;
        inset: 0;
        opacity: 0.12;
        background-image:
          linear-gradient(rgb(255 255 255 / 13%) 1px, transparent 1px),
          linear-gradient(90deg, rgb(255 255 255 / 13%) 1px, transparent 1px);
        background-size: 5rem 5rem;
        mask-image: linear-gradient(to bottom, #000, transparent 75%);
        content: "";
        pointer-events: none;
      }

      .section-inner {
        position: relative;
        display: grid;
        grid-template-columns: minmax(15rem, 0.55fr) minmax(32rem, 1fr);
        gap: clamp(3rem, 8vw, 8rem);
        align-items: start;
        width: min(100% - 3rem, 78rem);
        margin: 0 auto;
        padding: clamp(5rem, 10vw, 8rem) 0;
      }

      .section-copy {
        position: sticky;
        top: 5rem;
        padding-top: 0.4rem;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0 0 1.2rem;
        color: #b96eff;
        font: 0.65rem "SFMono-Regular", Consolas, monospace;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .eyebrow::before { width: 2rem; height: 1px; background: currentColor; content: ""; }

      .section-copy h2 {
        margin: 0;
        font-size: clamp(3.2rem, 6vw, 5.6rem);
        font-weight: 630;
        letter-spacing: -0.075em;
        line-height: 0.86;
      }

      .section-copy p:not(.eyebrow) {
        max-width: 24rem;
        margin: 1.8rem 0 0;
        color: #8e8a94;
        font-size: 0.9rem;
        line-height: 1.7;
      }

      .links {
        display: flex;
        gap: 1.25rem;
        margin-top: 2.2rem;
      }

      .links a {
        color: #b4b0ba;
        font: 0.65rem "SFMono-Regular", Consolas, monospace;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .links a:hover { color: #fff; }

      @media (max-width: 52rem) {
        .section-inner { grid-template-columns: 1fr; }
        .section-copy { position: static; }
        .section-copy p:not(.eyebrow) { max-width: 34rem; }
      }

      @media (max-width: 32rem) {
        .hero h1 { font-size: 17vw; letter-spacing: -0.065em; }
        .section-inner { width: min(100% - 2rem, 78rem); padding-block: 4rem; }
        .section-copy h2 { font-size: 3.5rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        :global(html) { scroll-behavior: auto; }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="page-title">
        <div class="dither" aria-hidden="true">
          <Dither client:load waveColor={[0.56, 0.21, 1]} backgroundColor={[0.02, 0.02, 0.02]} waveSpeed={0.05} waveFrequency={3} waveAmplitude={0.3} colorNum={4} pixelSize={3} enableMouseInteraction={false} mouseRadius={0.3} />
        </div>
        <h1 id="page-title">AS218822</h1>
        <a class="scroll-link" href="#looking-glass">Looking glass</a>
      </section>

      <section class="looking-glass-section" id="looking-glass" aria-labelledby="looking-glass-title">
        <div class="section-inner">
          <div class="section-copy">
            <p class="eyebrow">Network observatory</p>
            <h2 id="looking-glass-title">See the route.</h2>
            <p>Inspect live BGP routes and test IPv6 reachability from the AS218822 core router in Asia Pacific.</p>
            <div class="links">
              <a href="https://www.peeringdb.com/net/43433">PeeringDB</a>
              <a href="https://github.com/pmh-only/AS218822">Source</a>
            </div>
          </div>
          <LookingGlass client:load apiUrl={apiUrl} />
        </div>
      </section>
    </main>
  </body>
</html>
